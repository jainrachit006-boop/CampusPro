# Campus Intelligence Frontend Environment Variables
# 
# Never commit .env files to version control.
# Never put OpenRouter API keys in frontend environment variables.

# Supabase configuration - REQUIRED for complaint operations
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# If Supabase is not configured, the app will use mock data mode
# and display a configuration warning